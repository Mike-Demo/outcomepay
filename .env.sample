# Copy to .env.local and fill in. Never commit real credentials.
# Get these from the PayPal Developer Dashboard (Apps & Credentials → Sandbox):
# https://developer.paypal.com/dashboard/
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# SANDBOX (default) or LIVE. This project only ever uses SANDBOX.
PAYPAL_ENVIRONMENT=SANDBOX
# Public URL of the deployed demo, used for PayPal return/cancel redirects.
# Example: https://outcomepay.view.fast
PUBLIC_BASE_URL=http://localhost:3000

# --- Phase 2: provider LLM (optional; without this, providers serve cached artifacts) ---
# Option A (recommended, free): Groq — free tier, no card, OpenAI-compatible
#   1. Sign up at https://console.groq.com and create an API key
#   2. sf env set LLM_API_KEY <key> / LLM_BASE_URL https://api.groq.com/openai/v1
# Option B: OpenRouter free models — https://openrouter.ai
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
