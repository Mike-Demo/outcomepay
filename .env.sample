# Copy to .env.local and fill in. Never commit real credentials.
# Get these from the PayPal Developer Dashboard (Apps & Credentials → Sandbox):
# https://developer.paypal.com/dashboard/
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# SANDBOX (default) or LIVE. This project only ever uses SANDBOX.
PAYPAL_ENVIRONMENT=SANDBOX
# Public URL of the deployed demo, used for PayPal return/cancel redirects.
# Example: https://outcomepay.view.fast
PUBLIC_BASE_URL=http://localhost:3000
