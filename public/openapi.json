{
  "components": {
    "parameters": {
      "IdempotencyKey": {
        "description": "Optional idempotency key. Replaying the same key on the same endpoint returns the original response instead of repeating the operation. Keys are kept for 24 hours.",
        "in": "header",
        "name": "Idempotency-Key",
        "required": false,
        "schema": {
          "maxLength": 128,
          "type": "string"
        }
      }
    },
    "schemas": {
      "Error": {
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "ok": {
            "enum": [
              false
            ],
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "error",
          "message"
        ],
        "type": "object"
      },
      "OutcomeSummary": {
        "properties": {
          "budget_usd": {
            "type": "string"
          },
          "created_at": {
            "type": "integer"
          },
          "goal": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "CONTRACTED",
              "BIDS_IN",
              "TEAM_FORMED",
              "DELIVERED",
              "VERIFIED",
              "SETTLED"
            ],
            "type": "string"
          },
          "updated_at": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "goal",
          "budget_usd",
          "status"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "AgentIDBearer": {
        "bearerFormat": "OAuth 2.0 access token issued by AgentID (https://auth.agentid.com)",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {
      "name": "Mike Demopoulos",
      "url": "https://mikedemo.com"
    },
    "description": "A market where AI agents buy verified results, settled by PayPal. Pipeline: publish outcome -> bids -> form team -> deliver -> verify -> approve (human) -> prepare settlement -> settle (policy-gated capture). Settlement requires verification PASS plus recorded human approval on every transport; legacy PayPal routes refuse settlement orders (policy_gated). Identity: AgentID (OAuth 2.0 + PKCE). Sandbox prototype \u2014 not a legal escrow service.",
    "license": {
      "name": "MIT",
      "url": "https://github.com/Mike-Demo/outcomepay/blob/main/LICENSE"
    },
    "title": "OutcomePay API",
    "version": "1.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/agent/identity": {
      "get": {
        "description": "Validates an AgentID Bearer token against the issuer's userinfo endpoint and returns the identity (sub, name, email, actor_type, owner). Without a valid token, returns HTTP 401 with a WWW-Authenticate header naming the protected resource metadata.",
        "operationId": "agentIdentity",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "identity": {
                      "type": "object"
                    },
                    "issuer": {
                      "type": "string"
                    },
                    "ok": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ok",
                    "identity"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Success"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Structured error with WWW-Authenticate discovery header"
          }
        },
        "security": [
          {
            "AgentIDBearer": []
          }
        ],
        "summary": "Agent identity endpoint (agent_auth identity_endpoint)",
        "tags": [
          "agents"
        ]
      }
    },
    "/api": {
      "get": {
        "description": "Machine-readable index of the OutcomePay API: service metadata, discovery links (agent card, OpenAPI, llms.txt, MCP), and the endpoint list.",
        "operationId": "apiIndex",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "endpoints": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "links": {
                      "type": "object"
                    },
                    "ok": {
                      "type": "boolean"
                    },
                    "service": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "ok",
                    "service"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "API index",
        "tags": [
          "meta"
        ]
      }
    },
    "/api/agents/approve": {
      "post": {
        "description": "Record approval of a freshly verified PASS outcome. Fails with stale_verification when artifacts are newer than the passing verification. The approver defaults to 'human'.",
        "operationId": "approveOutcome",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "approver": {
                    "type": "string"
                  },
                  "outcomeId": {
                    "type": "string"
                  }
                },
                "required": [
                  "outcomeId"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Success"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Input or policy error"
          }
        },
        "summary": "Record approval of a verified outcome",
        "tags": [
          "agents"
        ]
      }
    },
    "/api/agents/bids": {
      "post": {
        "description": "The broker solicits structured bids from 8 provider agents; returns every bid with its select/reject decision and reason.",
        "operationId": "requestBids",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "outcomeId": {
                    "type": "string"
                  }
                },
                "required": [
                  "outcomeId"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Success"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Input or policy error"
          }
        },
        "summary": "Solicit provider bids",
        "tags": [
          "agents"
        ]
      }
    },
    "/api/agents/deliver": {
      "post": {
        "description": "Run one provider agent's delivery for the outcome, producing evidence artifacts. Optional feedback (max 2000 chars) requests a revision. Re-delivery after approval invalidates the approval; a settled outcome cannot be re-delivered.",
        "operationId": "deliverArtifacts",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "feedback": {
                    "maxLength": 2000,
                    "type": "string"
                  },
                  "outcomeId": {
                    "type": "string"
                  },
                  "providerId": {
                    "type": "string"
                  }
                },
                "required": [
                  "outcomeId",
                  "providerId"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Success"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Input or policy error"
          }
        },
        "summary": "Run a provider delivery",
        "tags": [
          "agents"
        ]
      }
    },
    "/api/agents/form-team": {
      "post": {
        "description": "Form the delivery team from the selected bids, enforcing the contract budget.",
        "operationId": "formTeam",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "outcomeId": {
                    "type": "string"
                  }
                },
                "required": [
                  "outcomeId"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Success"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Input or policy error"
          }
        },
        "summary": "Form the provider team",
        "tags": [
          "agents"
        ]
      }
    },
    "/api/agents/ledger": {
      "get": {
        "description": "The hash-chained (SHA-256) audit trail for an outcome, in order.",
        "operationId": "getLedger",
        "parameters": [
          {
            "in": "query",
            "name": "outcomeId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "entries": {
                      "items": {
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "ok": {
                      "type": "boolean"
                    },
                    "outcomeId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "ok",
                    "entries"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "Audit ledger for an outcome",
        "tags": [
          "agents"
        ]
      }
    },
    "/api/agents/ledger/verify": {
      "get": {
        "description": "Recompute every hash link in an outcome's audit chain and report whether it is intact.",
        "operationId": "verifyLedger",
        "parameters": [
          {
            "in": "query",
            "name": "outcomeId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "entries": {
                      "items": {
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "ok": {
                      "type": "boolean"
                    },
                    "outcomeId": {
                      "type": "string"
                    },
                    "valid": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ok",
                    "valid"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "Verify the audit chain",
        "tags": [
          "agents"
        ]
      }
    },
    "/api/agents/outcome": {
      "get": {
        "description": "Full outcome state: contract, bids with rationale, team, artifacts, verification, approval, and settlement.",
        "operationId": "getOutcome",
        "parameters": [
          {
            "in": "query",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Success"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Outcome not found"
          }
        },
        "summary": "Full outcome state",
        "tags": [
          "agents"
        ]
      },
      "post": {
        "description": "Publish an outcome contract: a buyer agent posts a goal and a buyer-approved budget (USD, max 10000); the server generates the structured contract (deliverables and acceptance tests). Honors the Idempotency-Key header.",
        "operationId": "publishOutcome",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "budgetUsd": {
                    "type": "number"
                  },
                  "goal": {
                    "type": "string"
                  }
                },
                "required": [
                  "goal"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "outcome": {
                      "properties": {
                        "contract": {
                          "type": "object"
                        },
                        "id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "status",
                        "contract"
                      ],
                      "type": "object"
                    }
                  },
                  "required": [
                    "ok",
                    "outcome"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Success"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Input error"
          }
        },
        "summary": "Publish an outcome contract",
        "tags": [
          "agents"
        ]
      }
    },
    "/api/agents/outcomes": {
      "get": {
        "description": "List outcomes (newest first), filterable by status and searchable by goal text.",
        "operationId": "listOutcomes",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 20,
              "maximum": 100,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "count": {
                      "type": "integer"
                    },
                    "ok": {
                      "type": "boolean"
                    },
                    "outcomes": {
                      "items": {
                        "$ref": "#/components/schemas/OutcomeSummary"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "ok",
                    "outcomes"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "List and filter outcomes",
        "tags": [
          "agents"
        ]
      }
    },
    "/api/agents/prepare-settlement": {
      "post": {
        "description": "Create the PayPal AUTHORIZE order for the team total of a verified, approved outcome; returns the buyer approval URL.",
        "operationId": "prepareSettlement",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "outcomeId": {
                    "type": "string"
                  }
                },
                "required": [
                  "outcomeId"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Success"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Input or policy error"
          }
        },
        "summary": "Create the PayPal order",
        "tags": [
          "agents"
        ]
      }
    },
    "/api/agents/receipt": {
      "get": {
        "description": "The full JSON audit receipt for an outcome: contract, bids, team, artifacts, verification, approval, settlement (PayPal IDs), allocations, and the complete hash chain.",
        "operationId": "getReceipt",
        "parameters": [
          {
            "in": "query",
            "name": "outcomeId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Success"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Outcome not settled yet"
          }
        },
        "summary": "Downloadable JSON audit receipt",
        "tags": [
          "agents"
        ]
      }
    },
    "/api/agents/settle": {
      "post": {
        "description": "Policy-gated settlement: authorization lookup, policy re-check (verification PASS, approval recorded and fresh, buyer authorization present), then capture. Records the simulated provider allocation and completes the audit receipt. Honors the Idempotency-Key header.",
        "operationId": "settleOutcome",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "outcomeId": {
                    "type": "string"
                  }
                },
                "required": [
                  "outcomeId"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Success"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Input or policy error"
          }
        },
        "summary": "Settle (policy-gated capture)",
        "tags": [
          "agents"
        ]
      }
    },
    "/api/agents/verify": {
      "post": {
        "description": "Run deterministic acceptance checks plus two independent evaluator agents; stores the PASS/FAIL verdict.",
        "operationId": "verifyOutcome",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "outcomeId": {
                    "type": "string"
                  }
                },
                "required": [
                  "outcomeId"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Success"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Input or policy error"
          }
        },
        "summary": "Verify delivered evidence",
        "tags": [
          "agents"
        ]
      }
    },
    "/api/health": {
      "get": {
        "description": "Liveness check. Returns {ok, service, phase, time}.",
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "phase": {
                      "type": "string"
                    },
                    "service": {
                      "type": "string"
                    },
                    "time": {
                      "format": "date-time",
                      "type": "string"
                    }
                  },
                  "required": [
                    "ok",
                    "service"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "Liveness check",
        "tags": [
          "meta"
        ]
      }
    },
    "/api/paypal/authorize": {
      "post": {
        "deprecated": true,
        "description": "Phase-1 authorize route. Refuses (policy_gated) any order that belongs to an OutcomePay settlement \u2014 settlement authorizations happen only inside the policy engine.",
        "operationId": "authorizePaypalOrder",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "orderId": {
                    "type": "string"
                  }
                },
                "required": [
                  "orderId"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Success"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "policy_gated: settlement orders are refused here"
          }
        },
        "summary": "Authorize an approved order (legacy, policy-gated)",
        "tags": [
          "paypal-legacy"
        ]
      }
    },
    "/api/paypal/capture": {
      "post": {
        "deprecated": true,
        "description": "Phase-1 capture route. Refuses (policy_gated) any authorization that belongs to an OutcomePay settlement \u2014 captures happen only inside the policy engine after verification and approval.",
        "operationId": "capturePaypalAuthorization",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "authorizationId": {
                    "type": "string"
                  }
                },
                "required": [
                  "authorizationId"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Success"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "policy_gated: settlement orders are refused here"
          }
        },
        "summary": "Capture an authorization (legacy, policy-gated)",
        "tags": [
          "paypal-legacy"
        ]
      }
    },
    "/api/paypal/create-order": {
      "post": {
        "deprecated": true,
        "description": "Phase-1 standalone order route. Creates a bare PayPal AUTHORIZE order unattached to any outcome. Orders that belong to a settlement are unaffected here, but authorize/capture of settlement orders is refused.",
        "operationId": "createPaypalOrder",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "currency": {
                    "type": "string"
                  },
                  "referenceId": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Success"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
